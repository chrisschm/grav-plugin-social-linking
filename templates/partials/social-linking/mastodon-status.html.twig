{% set outer = embed %}
{% set s = embed.reblog ?: embed %}
<div class="se se-mastodon se-status"{% if s.language %} lang="{{ s.language }}"{% endif %}>

    {% if outer.reblog %}
        <div class="se-boost-header">
            <svg class="se-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 1l4 4-4 4M3 11V9a4 4 0 0 1 4-4h14M7 23l-4-4 4-4M21 13v2a4 4 0 0 1-4 4H3"/></svg>
            <a href="{{ outer.account.url }}" target="_blank" rel="noopener noreferrer nofollow">{{ outer.account.display_name }}</a>
            <span>teilte</span>
        </div>
    {% endif %}

    <div class="se-header">
        {% if s.account.avatar %}
            <img class="se-avatar" src="{{ s.account.avatar }}" alt="" loading="lazy" width="48" height="48">
        {% endif %}
        <div class="se-identity">
            <a class="se-display-name" href="{{ s.account.url }}" target="_blank" rel="noopener noreferrer nofollow">{{ s.account.display_name }}</a>
            <span class="se-handle">@{{ s.account.acct }}</span>
        </div>
        <a class="se-source-link" href="{{ s.url }}" target="_blank" rel="noopener noreferrer nofollow" title="Original auf {{ s.instance }} ansehen" aria-label="Original ansehen">
            <svg class="se-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-5M12 8h.01"/></svg>
        </a>
    </div>

    {% if s.spoiler_text %}
        <details class="se-cw">
            <summary>{{ s.spoiler_text }}</summary>
            <div class="se-content">{{ s.content_html|raw }}</div>
        </details>
    {% else %}
        <div class="se-content">{{ s.content_html|raw }}</div>
    {% endif %}

    {% if s.media_attachments|length %}
        {% set revealId = 'se-reveal-' ~ s.instance ~ '-' ~ s.id %}
        {% if s.sensitive %}
            <input type="checkbox" id="{{ revealId }}" class="se-reveal-toggle">
        {% endif %}
        <div class="se-media se-media-{{ s.media_attachments|length > 1 ? 'grid' : 'single' }}{{ s.sensitive ? ' se-media-sensitive' : '' }}">
            {% for m in s.media_attachments %}
                {% if m.type == 'video' %}
                    <video src="{{ m.url }}" poster="{{ m.preview_url }}" controls></video>
                {% elseif m.type == 'audio' %}
                    <audio src="{{ m.url }}" controls></audio>
                {% else %}
                    <img src="{{ m.preview_url ?: m.url }}" alt="{{ m.description }}" loading="lazy">
                {% endif %}
            {% endfor %}
            {% if s.sensitive %}
                <label for="{{ revealId }}" class="se-media-cw-overlay">
                    <span class="se-media-cw-text">{{ s.spoiler_text ?: 'Als sensibel markierte Medien' }}</span>
                    <span class="se-media-cw-button">Medien anzeigen</span>
                </label>
            {% endif %}
        </div>
    {% endif %}

    {% if s.card %}
        <a class="se-card" href="{{ s.card.url }}" target="_blank" rel="noopener noreferrer nofollow">
            {% if s.card.image %}
                <div class="se-card-image" style="background-image:url('{{ s.card.image }}');"></div>
            {% endif %}
            <div class="se-card-body">
                {% if s.card.provider_name %}<span class="se-card-provider">{{ s.card.provider_name }}</span>{% endif %}
                <span class="se-card-title">{{ s.card.title }}</span>
                {% if s.card.description %}<span class="se-card-desc">{{ s.card.description }}</span>{% endif %}
            </div>
        </a>
    {% endif %}

    <div class="se-footer">
        {% if s.created_at %}<time datetime="{{ s.created_at }}">{{ s.created_at|date('d.m.Y, H:i') }}</time>{% endif %}
        <span class="se-stat" title="Antworten">
            <svg class="se-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            {{ s.stats.replies_count }}
        </span>
        <span class="se-stat" title="Geteilt">
            <svg class="se-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 1l4 4-4 4M3 11V9a4 4 0 0 1 4-4h14M7 23l-4-4 4-4M21 13v2a4 4 0 0 1-4 4H3"/></svg>
            {{ s.stats.reblogs_count }}
        </span>
        <span class="se-stat" title="Favorisiert">
            <svg class="se-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.7-4.35-9.3-8.1C1 10.1 1.6 6.7 4.6 5.2 7 4 9.6 4.9 12 7.3 14.4 4.9 17 4 19.4 5.2c3 1.5 3.6 4.9 1.9 7.7C18.7 16.65 12 21 12 21z"/></svg>
            {{ s.stats.favourites_count }}
        </span>
        <a class="se-permalink" href="{{ s.url }}" target="_blank" rel="noopener noreferrer nofollow">Auf {{ s.instance }} ansehen ↗</a>
    </div>
</div>
