{% set a = embed.account is defined and embed.account is not empty ? embed.account : embed %}
<div class="se se-mastodon se-profile">
    <div class="se-profile-header"{% if a.header %} style="background-image:url('{{ a.header }}');"{% endif %}></div>
    <div class="se-profile-body">
        {% if a.avatar %}
            <img class="se-avatar se-avatar-lg" src="{{ a.avatar }}" alt="" loading="lazy">
        {% endif %}

        <div class="se-profile-identity">
            <a class="se-display-name" href="{{ a.url }}" target="_blank" rel="noopener noreferrer nofollow">
                {{ a.display_name }}
                {% if a.locked %}
                    <svg class="se-icon" viewBox="0 0 24 24" aria-hidden="true"><title>{{ 'PLUGIN_SOCIAL_LINKING.LOCKED_ACCOUNT'|t }}</title><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                {% endif %}
            </a>
            <span class="se-handle">@{{ a.acct }}{% if a.bot %} · {{ 'PLUGIN_SOCIAL_LINKING.BOT'|t }}{% endif %}</span>
        </div>

        {% if a.note_html %}
            <div class="se-profile-note">{{ a.note_html|raw }}</div>
        {% endif %}

        <div class="se-profile-stats">
            <div class="se-stat-block"><strong>{{ a.followers_count|default(0) }}</strong><span>{{ 'PLUGIN_SOCIAL_LINKING.FOLLOWERS'|t }}</span></div>
            <div class="se-stat-block"><strong>{{ a.following_count|default(0) }}</strong><span>{{ 'PLUGIN_SOCIAL_LINKING.FOLLOWING'|t }}</span></div>
            <div class="se-stat-block"><strong>{{ a.statuses_count|default(0) }}</strong><span>{{ 'PLUGIN_SOCIAL_LINKING.POSTS'|t }}</span></div>
            {% if a.created_at %}
                <div class="se-stat-block"><strong>{{ a.created_at|date('Y') }}</strong><span>{{ 'PLUGIN_SOCIAL_LINKING.JOINED'|t }}</span></div>
            {% endif %}
        </div>

        {% if a.fields|length %}
            <div class="se-profile-fields">
                {% for f in a.fields %}
                    <div class="se-field{{ f.verified ? ' se-field-verified' : '' }}">
                        <span class="se-field-name">{{ f.name }}</span>
                        <span class="se-field-value">{{ f.value_html|raw }}</span>
                        {% if f.verified %}
                            <svg class="se-icon se-field-check" viewBox="0 0 24 24" aria-hidden="true"><title>{{ 'PLUGIN_SOCIAL_LINKING.VERIFIED'|t }}</title><path d="M20 6 9 17l-5-5"/></svg>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
